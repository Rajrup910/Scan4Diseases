{
  "Urls": "http://0.0.0.0:8080",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-open": {
        "ClusterId": "fastapi",
        "Match": { "Path": "/auth/{**rest}" }
      },
      "health-open": {
        "ClusterId": "fastapi",
        "Match": { "Path": "/health" }
      },
      "secure-all": {
        "ClusterId": "fastapi",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "fastapi": {
        "Destinations": {
          "backend": { "Address": "http://127.0.0.1:8000/" }
        }
      }
    }
  }
}
