# Normalise line endings so Windows/macOS/Linux collaborators get consistent diffs.
* text=auto eol=lf

# Scripts that must keep their platform's native endings
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Treat these as binary (never diff or normalise)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.apk   binary
*.aab   binary
*.pt    binary
*.pth   binary
*.onnx  binary
*.tflite binary
*.npz   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
