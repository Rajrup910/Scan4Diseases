# Copy to backend/.env (or export in your shell). Never commit the real .env.

# ---------- Server ----------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
# Comma-separated list. Use explicit origins in production.
CORS_ORIGINS=*

# ---------- Model ----------
# Path to the deployed classifier checkpoint (relative to repo root or absolute).
MODEL_CHECKPOINT=ml/checkpoints/deployed_model.pt
# Must match the architecture the checkpoint was trained with: resnet50 | efficientnet_b0
MODEL_ARCH=efficientnet_b0
MODEL_IMAGE_SIZE=224
MODEL_DEVICE=auto
CLASS_MAPPING_PATH=ml/configs/class_mapping.json

# ---------- Inference thresholds ----------
# Below this softmax score the result is reported as low-confidence and triage is escalated.
LOW_CONFIDENCE_THRESHOLD=0.60
# Optional temperature-scaling value produced by calibration (1.0 = uncalibrated).
CALIBRATION_TEMPERATURE=1.0

# ---------- Out-of-distribution (OOD) detection ----------
# Reject non-lesion images (a hand, a wall) using Mahalanobis distance on model features.
# Needs the artifact from `python -m ml.ood.fit_mahalanobis`; if missing, the gate is off.
OOD_ENABLED=true
OOD_STATS_PATH=ml/checkpoints/ood_mahalanobis.npz
# Optional: override the fitted Mahalanobis threshold without re-fitting.
# OOD_THRESHOLD=28519

# Binary lesion-presence gate: rejects skin-but-not-lesion photos (a forearm, a hand)
# that the distance metric can't separate. Needs `python -m ml.ood.fit_lesion_gate`
# plus non-lesion photos in data/ood_negatives/. If missing, this gate is off.
LESION_GATE_ENABLED=true
LESION_GATE_PATH=ml/checkpoints/lesion_gate.npz
# Optional: override the fitted P(lesion) decision threshold without re-fitting.
# LESION_GATE_THRESHOLD=0.5

# ---------- Image quality gate ----------
QUALITY_MIN_SIDE_PX=224
QUALITY_MAX_UPLOAD_MB=10
QUALITY_BLUR_THRESHOLD=45.0
QUALITY_DARK_THRESHOLD=40.0
QUALITY_BRIGHT_THRESHOLD=225.0

# ---------- Storage ----------
# Temporary storage for uploaded images and Grad-CAM overlays.
STORAGE_DIR=backend/storage
# Files older than this are deleted by the janitor task. Set 0 to keep nothing on disk.
STORAGE_TTL_MINUTES=15

# ---------- Shared-image encryption ----------
# A patient's lesion image is persisted ONLY when they share a report, and only ever as a
# Fernet-encrypted blob under STORAGE_DIR/shared. This is the symmetric key. REQUIRED for
# image sharing; leave unset and /predict, saving reports and metadata-only sharing still
# work, but uploading/serving a shared image returns 503 (never a plaintext fallback).
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IMAGE_ENCRYPTION_KEY=

# ---------- Database & Auth ----------
# SQLite file for users and saved reports (relative to repo root or absolute).
DATABASE_PATH=backend/storage/app.db
# REQUIRED in any real deployment. Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Tokens signed with the built-in dev default are trivially forgeable.
JWT_SECRET=change-me-generate-a-long-random-secret
# How long a login stays valid (minutes). Default is 14 days.
JWT_EXPIRE_MINUTES=20160

# ---------- LLM (Ollama, OpenAI-compatible endpoint) ----------
LLM_ENABLED=true
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3
